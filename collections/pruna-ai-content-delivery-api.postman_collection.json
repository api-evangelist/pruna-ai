            "name": "Download generated content",
            "description": {
              "content": "Download the generated content file. This is the third and final\nstep in the workflow.\n\nUse the `generation_url` from the prediction status response directly - no path extraction needed.\nSimply make a GET request to that URL with your API key.\n\nRate limit: 10,000 requests per minute.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "predictions",
                "delivery",
                ":path"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "path",
                  "description": "(Required) The delivery path returned in the prediction status response"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "image/jpeg"
              }
            ],
            "method": "GET",
            "auth": {
