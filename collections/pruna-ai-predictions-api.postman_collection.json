          "name": "Submit a content generation request",
          "request": {
            "name": "Submit a content generation request",
            "description": {
              "content": "Submit a request to generate images or videos using one of the\navailable AI models. This is the first step in the workflow.\n\nThe request will be queued for processing and you'll receive a prediction\nID to track its status.\n\nThe model to use is specified via the `Model` header. The request body structure\nvaries by model (see examples below).\n\nIf the `Try-Sync` header is set to true, the API will wait up to 60 seconds\nfor completion. If generation completes within this time, the response will\ninclude the final result directly.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "predictions"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) The AI model to use for generation. Each model has specific capabilities and input requirements.",
                "key": "Model",
                "value": "<string>"
              },
              {
                "disabled": false,
                "description": "If true, the API will wait up to 60 seconds for the generation to complete.",
                "key": "Try-Sync",
                "value": "false"
